# Also read by pkg.pr.new: it filters the StackBlitz template with THIS file
# (only `node_modules` and `.git` are excluded unconditionally), so anything
# that must not ship to the sandbox has to be listed here, not just in the
# repository root .gitignore.

# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# Node dependencies
node_modules

# Logs
logs
*.log

# Misc
.DS_Store
.fleet
.idea

# The Convex CLI's local deployment state. It ignores itself with a
# .gitignore inside, which pkg.pr.new does not read.
.convex

# Local env files. `npx convex dev` writes CONVEX_DEPLOYMENT and CONVEX_URL to
# .env.local — yours, not the example's.
.env
.env.*
!.env.example

# A lockfile would ship to StackBlitz and pin the *registry* version of
# nuxt-convex-module, defeating the preview build the template exists to
# exercise.
package-lock.json
pnpm-lock.yaml
yarn.lock
bun.lockb

# NOT ignored, on purpose: convex/_generated. Committing the codegen is what
# lets the sandbox type-check and build before `npx convex dev` has ever run.
