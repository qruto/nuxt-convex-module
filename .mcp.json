{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "chrome-devtools-mcp@latest",
        "--autoConnect"
      ]
    },
    "convex": {
      "command": "npx",
      "args": [
        "-y",
        "convex@latest",
        "mcp",
        "start",
        "--project-dir",
        "website"
      ]
    },
    "nuxt-docs": {
      "type": "http",
      "url": "https://nuxt.com/mcp"
    },
    "better-auth-docs": {
      "url": "https://mcp.better-auth.com/mcp",
      "type": "https"
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "vercel": {
      "type": "http",
      "url": "https://mcp.vercel.com"
    },
    "fallow": {
      "type": "stdio",
      "command": "fallow-mcp"
    }
  }
}
