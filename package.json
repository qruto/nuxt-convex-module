{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "nuxt-convex-module",
  "version": "0.0.0",
  "description": "The Convex client for Vue & Nuxt — reactive live queries, mutations, actions, cursor pagination, file storage, connection state and SSR, with opt-in Better Auth and Polar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qruto/nuxt-convex-module.git"
  },
  "license": "MIT",
  "author": "Slava Razum <razum@qruto.to>",
  "homepage": "https://github.com/qruto/nuxt-convex-module#readme",
  "bugs": {
    "url": "https://github.com/qruto/nuxt-convex-module/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/qruto"
  },
  "keywords": [
    "nuxt",
    "nuxt-module",
    "vue",
    "convex",
    "better-auth",
    "polar",
    "realtime",
    "ssr"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./client": {
      "types": "./dist/runtime/vue/index.d.ts",
      "import": "./dist/runtime/vue/index.js"
    },
    "./vue": {
      "types": "./dist/runtime/vue/index.d.ts",
      "import": "./dist/runtime/vue/index.js"
    },
    "./server": {
      "types": "./dist/runtime/nuxt/index.d.ts",
      "import": "./dist/runtime/nuxt/index.js"
    },
    "./better-auth/client": {
      "types": "./dist/runtime/better-auth/vue/index.d.ts",
      "import": "./dist/runtime/better-auth/vue/index.js"
    },
    "./better-auth/server": {
      "types": "./dist/runtime/better-auth/nuxt/server.d.ts",
      "import": "./dist/runtime/better-auth/nuxt/server.js"
    },
    "./polar/client": {
      "types": "./dist/runtime/polar/vue/components.d.ts",
      "import": "./dist/runtime/polar/vue/components.js"
    },
    "./polar/vue": {
      "types": "./dist/runtime/polar/vue/components.d.ts",
      "import": "./dist/runtime/polar/vue/components.js"
    },
    "./clerk/client": {
      "types": "./dist/runtime/clerk/vue/index.d.ts",
      "import": "./dist/runtime/clerk/vue/index.js"
    },
    "./clerk/vue": {
      "types": "./dist/runtime/clerk/vue/index.d.ts",
      "import": "./dist/runtime/clerk/vue/index.js"
    },
    "./auth0/client": {
      "types": "./dist/runtime/auth0/vue/index.d.ts",
      "import": "./dist/runtime/auth0/vue/index.js"
    },
    "./auth0/vue": {
      "types": "./dist/runtime/auth0/vue/index.d.ts",
      "import": "./dist/runtime/auth0/vue/index.js"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ],
      "client": [
        "./dist/runtime/vue/index.d.ts"
      ],
      "vue": [
        "./dist/runtime/vue/index.d.ts"
      ],
      "server": [
        "./dist/runtime/nuxt/index.d.ts"
      ],
      "better-auth/client": [
        "./dist/runtime/better-auth/vue/index.d.ts"
      ],
      "better-auth/server": [
        "./dist/runtime/better-auth/nuxt/server.d.ts"
      ],
      "polar/client": [
        "./dist/runtime/polar/vue/components.d.ts"
      ],
      "polar/vue": [
        "./dist/runtime/polar/vue/components.d.ts"
      ],
      "clerk/client": [
        "./dist/runtime/clerk/vue/index.d.ts"
      ],
      "clerk/vue": [
        "./dist/runtime/clerk/vue/index.d.ts"
      ],
      "auth0/client": [
        "./dist/runtime/auth0/vue/index.d.ts"
      ],
      "auth0/vue": [
        "./dist/runtime/auth0/vue/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "engines": {
    "node": ">=24.11.0",
    "pnpm": ">=11.6.0"
  },
  "scripts": {
    "prepare": "git config hook.commitlint.event commit-msg && git config hook.commitlint.command 'pnpm exec commitlint --edit' || true",
    "prepack": "pnpm run build",
    "build": "nuxt-module-build build && pnpm run build:devtools-client",
    "build:devtools-client": "nuxt generate devtools-client-app",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare website",
    "dev": "pnpm run dev:prepare && pnpm --dir website exec convex dev --start 'portless run --name nuxt-convex-module nuxt dev'",
    "dev:devtools-client": "nuxt dev devtools-client-app --port 3630",
    "start": "pnpm run dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest --run --project \"!e2e\"",
    "test:coverage": "vitest --run --coverage --project \"!e2e\"",
    "test:watch": "vitest --watch --project \"!e2e\"",
    "test:types": "pnpm run test:types:lib && nuxt typecheck website",
    "test:types:lib": "pnpm run dev:prepare && vue-tsc --noEmit",
    "test:unit": "vitest --project unit --run",
    "test:nuxt": "vitest --project nuxt --run",
    "test:e2e": "vitest --run --project e2e",
    "test:quality": "fallow",
    "docs:api": "typedoc && node scripts/typedoc-postprocess.mjs",
    "bump": "pnpm exec taze major -w"
  },
  "dependencies": {
    "@nuxt/devtools-kit": "^3.4.0",
    "@nuxt/kit": "^4.5.1",
    "h3": "^1.15.11",
    "nuxt-security": "^2.6.0",
    "sirv": "^3.0.2"
  },
  "peerDependencies": {
    "@auth0/auth0-vue": ">=2.0.0",
    "@clerk/vue": ">=2.0.0",
    "@convex-dev/better-auth": ">=0.12.0",
    "@convex-dev/polar": ">=0.9.0",
    "@polar-sh/checkout": ">=0.3.0",
    "better-auth": ">=1.6.11 <1.7.0",
    "convex": ">=1.40.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@auth0/auth0-vue": {
      "optional": true
    },
    "@clerk/vue": {
      "optional": true
    },
    "@convex-dev/better-auth": {
      "optional": true
    },
    "@convex-dev/polar": {
      "optional": true
    },
    "@polar-sh/checkout": {
      "optional": true
    },
    "better-auth": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@auth0/auth0-vue": "^2.9.0",
    "@clerk/vue": "2.4.22",
    "@codecov/nuxt-plugin": "^2.0.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@convex-dev/better-auth": "^0.12.5",
    "@convex-dev/polar": "^0.9.2",
    "@nuxt/devtools": "^3.4.0",
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/eslint-config": "^1.16.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.1",
    "@nuxt/test-utils": "^4.1.0",
    "@polar-sh/checkout": "^0.4.0",
    "@types/node": "latest",
    "@types/ws": "^8.18.1",
    "@unhead/vue": "^3.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "better-auth": "~1.6.25",
    "changelogen": "^0.6.2",
    "changelogithub": "^15.0.5",
    "convex": "^1.45.0",
    "convex-helpers": "^0.1.120",
    "eslint": "^10.8.0",
    "fallow": "^3.11.0",
    "happy-dom": "^20.11.1",
    "npm-run-all2": "^9.0.3",
    "nuxt": "catalog:",
    "oxc-parser": "^0.142.0",
    "portless": "0.15.5",
    "publint": "^0.3.22",
    "typedoc": "^0.28.20",
    "typedoc-plugin-frontmatter": "^1.3.1",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8",
    "ws": "^8.21.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
