{
  "$schema": "https://typedoc.org/schema.json",
  "plugin": ["typedoc-plugin-markdown", "typedoc-plugin-frontmatter"],
  "tsconfig": "tsconfig.typedoc.json",

  "entryPoints": [
    "src/runtime/vue/index.ts",
    "src/runtime/nuxt/index.ts",
    "src/runtime/nuxt/app.ts",
    "src/runtime/nuxt/testing.ts",
    "src/runtime/convex-auth/vue/index.ts",
    "src/runtime/convex-auth/vue/methods/username-password.ts",
    "src/runtime/convex-auth/vue/methods/username-passkey/index.ts",
    "src/runtime/convex-auth/vue/methods/username-passkey/custom.ts",
    "src/runtime/convex-auth/vue/methods/email-password.ts",
    "src/runtime/convex-auth/vue/methods/email-magic-link.ts",
    "src/runtime/convex-auth/vue/methods/oauth.ts",
    "src/runtime/convex-auth/vue/methods/google.ts",
    "src/runtime/convex-auth/vue/methods/apple.ts",
    "src/runtime/convex-auth/vue/methods/github.ts",
    "src/runtime/convex-auth/vue/methods/discord.ts",
    "src/runtime/convex-auth/nuxt/server.ts",
    "src/runtime/clerk/vue/index.ts",
    "src/runtime/auth0/vue/index.ts",
    "src/runtime/better-auth/vue/index.ts",
    "src/runtime/better-auth/nuxt/server.ts",
    "src/runtime/polar/vue/components.ts",
    "src/runtime/rate-limiter/vue/index.ts",
    "src/runtime/presence/vue/index.ts",
    "src/runtime/presence/vue/facepile.ts",
    "src/runtime/r2/vue/index.ts",
    "src/runtime/persistent-text-streaming/vue/index.ts",
    "src/runtime/convex-helpers/vue/index.ts",
    "src/runtime/convex-helpers/vue/cache/index.ts",
    "src/runtime/convex-helpers/vue/sessions.ts"
  ],
  "entryPointStrategy": "resolve",

  "out": "website/content/4.api-reference/9.reference",
  "readme": "none",
  // Pin source links to the branch, not the current commit SHA — otherwise
  // every commit drifts the generated reference and the CI drift gate fails.
  // Spelled out as a template (not derived from the git remote) so the output
  // is identical from a worktree, where TypeDoc cannot detect the repository.
  // `{path}` is relative to the entry points' common directory, src/runtime;
  // `basePath` only governs the displayed "Defined in" text.
  "disableGit": true,
  "basePath": ".",
  "sourceLinkTemplate": "https://github.com/qruto/nuxt-convex-module/blob/main/src/runtime/{path}#L{line}",
  "githubPages": false,
  "hideGenerator": true,
  "skipErrorChecking": true,

  "excludeInternal": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "sort": ["source-order"],

  "router": "module",
  "entryFileName": "index",
  "hidePageHeader": true,
  "hideBreadcrumbs": true,
  "useCodeBlocks": true,
  "expandObjects": true,
  "parametersFormat": "table",
  "propertiesFormat": "table",
  "enumMembersFormat": "table",
  "typeDeclarationFormat": "table",
  "indexFormat": "table",

  "frontmatterGlobals": {
    "navigation": true
  }
}
