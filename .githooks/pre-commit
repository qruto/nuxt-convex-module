#!/bin/sh
# Fast gate, runs on every commit (~6s). The slower half of CI lives in
# pre-push; see CONTRIBUTING.md § Git Hooks for the split and for what neither
# hook can cover.
#
# Skipped in CI on purpose: the release job commits through changelogen, which
# shells out to a plain `git commit` (hooks and all), and a release must not be
# gated on checks the pull request already ran. `CI=1` also trips pnpm's
# `verifyDepsBeforeRun` guard, so these would fail there for the wrong reason.
#
# Every tool runs through `pnpm exec` / `pnpm run`: each is a devDependency and
# is on PATH only inside a pnpm script. A bare `fallow` would not resolve — the
# stock hook from `fallow hooks install` opens with `command -v fallow || exit 0`
# and would pass every commit while looking installed.
#
# Bypass once with: git commit --no-verify
if [ -n "$CI" ]; then exit 0; fi
set -e

# `quality` job. Scoped to the files this branch changed — fallow derives the
# merge-base with the branch upstream itself — and its `new-only` gate fails
# only on findings the change introduces.
pnpm exec fallow audit --gate-marker pre-commit

# `lint` job. Whole tree rather than staged files: the repo has no lint-staged,
# and eslint over this project costs about five seconds.
pnpm run lint
