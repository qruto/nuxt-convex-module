{
  "$schema": "./node_modules/fallow/schema.json",

  // Deliberately not a pnpm workspace: a standalone consumer sample with its own
  // package.json and committed convex/_generated files. fallow's own workspace
  // diagnostic points here and offers exactly this fix.
  "ignorePatterns": ["examples/**"],

  // Real runtime roots that no plugin declares.
  "entry": [
    "build.config.ts", // unbuild config, read by `nuxt-module-build`
    "test/setup/**/*.ts", // vitest projects[].setupFiles — the plugin only reads top-level
    "test/fixtures/**", // Nuxt apps @nuxt/test-utils boots by rootDir
    "website/app/app.css" // Docus convention load; seeds the @import chain into app/css/
  ],

  // Registered via `resolver.resolve()` in src/module.ts. The bare-string form of
  // addPlugin() resolves fine; addPlugin({ src }) and addServerHandler({ handler })
  // pass a computed path the static graph cannot follow.
  "dynamicallyLoaded": [
    "src/runtime/better-auth/nuxt/proxy.ts", // addServerHandler, module.ts:814
    "src/runtime/better-auth/vue/plugin.server.ts",
    "src/runtime/devtools/plugin.client.ts" // addPlugin({ src }), module.ts:190
  ],

  // The published `nuxt-convex-module/client` + `/vue` surface. `fallow dead-code
  // --trace src/runtime/vue/index.ts:useQuery` reports is_entry_point: true and
  // "export is externally accessible" — it just has no in-repo consumer, which is
  // the whole point of a library barrel. Scoped to this one file: the other public
  // barrels do have in-repo consumers and are not flagged.
  "ignoreExports": [
    { "file": "src/runtime/vue/index.ts", "exports": ["*"] }
  ],

  // Test doubles whose members are invoked through an interface or a patched global,
  // never by name: FakeWatch implements convex's Watch<T>, FakeXhr is installed over
  // globalThis.XMLHttpRequest by installFakeXhr(). ignoreFindings (not ignorePatterns)
  // keeps both files in the module graph.
  "ignoreFindings": [
    "test/fake-watch.ts",
    "test/helpers/fake-xhr.ts"
  ],

  // Installed on purpose, never imported.
  "ignoreDependencies": [
    "nuxt", // host-provided; src/runtime imports resolve to the app's nuxt
    "nuxt-security", // optional peer, detected by name via hasNuxtModule()
    "@convex-dev/polar", // optional peer, detected by name; website ships it for Convex
    "@polar-sh/checkout", // optional peer the website provides for the module's import
    "portless", // invoked inside the nested-quoted `dev` script
    "typedoc-plugin-frontmatter", // both listed as plain strings in typedoc.json "plugin"
    "typedoc-plugin-markdown"
  ]
}
