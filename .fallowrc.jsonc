{
  "$schema": "./node_modules/fallow/schema.json",

  // Standalone consumer apps (the starter template and the example), deliberately
  // not workspace members: their own package.json and committed convex/_generated
  // output. fallow's own workspace diagnostic points here and offers exactly this fix.
  "ignorePatterns": ["examples/**", "templates/**"],

  // Runtime roots no plugin discovers.
  "entry": [
    "build.config.ts", // unbuild config, read by nuxt-module-build
    "test/setup/**/*.ts", // vitest projects[].setupFiles — the plugin reads only the top level
    "test/fixtures/**", // Nuxt apps @nuxt/test-utils boots by rootDir
    // Type-level tests, deliberately outside every vitest project: the
    // assertions are the compile, so `test:types:lib`'s vue-tsc run is what
    // executes them. No test runner ever imports these files, so fallow cannot
    // reach them without this line.
    "test/types/**/*.test-d.ts",
    "website/app/app.css" // Docus convention load; seeds the @import chain into app/css/
  ],

  // Registered from src/module.ts through resolver.resolve(); the static graph
  // cannot follow the computed path.
  "dynamicallyLoaded": [
    "src/runtime/better-auth/nuxt/proxy.ts", // addServerHandler({ handler })
    "src/runtime/better-auth/nuxt/middleware.ts", // addRouteMiddleware({ path })
    "src/runtime/better-auth/vue/plugin.client.ts", // addPlugin(resolver.resolve(...))
    "src/runtime/better-auth/vue/plugin.server.ts", // addPlugin(resolver.resolve(...))
    "src/runtime/nuxt/security.ts", // addServerPlugin(resolver.resolve(...))
    "src/runtime/vue/plugin.ts", // addPlugin(resolver.resolve(...))
    "src/runtime/devtools/plugin.client.ts", // addPlugin({ src }, { append: true })
    "src/runtime/convex-helpers/vue/session-client.ts" // the `#convex/client-class` alias with `convexHelpers.sessionClient`
  ],

  // The website imports the module by its published name through the workspace
  // link, and those subpaths resolve through `dist/` — which is gitignored, so a
  // fresh checkout (CI, or anyone who has not built yet) has nothing to resolve
  // them to. Whether they resolve locally depends on whether `dist/` currently
  // holds a full build, a `dev:prepare` stub (whose `runtime` is a symlink to
  // `src`, so the `.js` entries do not exist), or nothing at all — which made an
  // inline suppression flap between active and stale. Suppress the specifier
  // instead: the finding is about the build state, never about the import.
  "ignoreUnresolvedImports": ["nuxt-convex-module", "nuxt-convex-module/**"],

  "ignoreExports": [
    // The published `nuxt-convex-module/client` (+ `/vue`) barrel. fallow marks it
    // an entry point yet still reports its re-exports, because the same file is
    // also seeded by the nuxt plugin as an auto-import source; the other public
    // barrels have in-repo consumers and are unaffected.
    { "file": "src/runtime/vue/index.ts", "exports": ["*"] },
    // Reached through the vitest `#imports` and `nuxt/server` aliases by the
    // runtime under test (vitest.config.ts declares them per project; the plugin
    // reads top-level only).
    // Copies of upstream's files, held to them by a test (PARITY.md D-20), and
    // the type files beside them. A copy keeps every export of the original.
    { "file": "src/runtime/convex-auth/upstream/methods/oauth/client.ts", "exports": ["*"] },
    { "file": "src/runtime/convex-auth/upstream/methods/username-passkey/**/*.ts", "exports": ["*"] },
    { "file": "test/helpers/nuxt-imports.ts", "exports": ["useRuntimeConfig"] },
    { "file": "test/helpers/nuxt-server.ts", "exports": ["*"] }
  ],

  // Test doubles whose members are invoked through an interface or a patched
  // global, never by name: FakeWatch implements convex's Watch<T>, FakeXhr is
  // installed over globalThis.XMLHttpRequest by installFakeXhr().
  "overrides": [
    {
      "files": ["test/fake-watch.ts", "test/helpers/fake-xhr.ts"],
      "rules": { "unused-class-members": "off" }
    }
  ],

  // Installed on purpose, never imported.
  "ignoreDependencies": [
    "nuxt", // host framework; src/runtime imports resolve to the app's nuxt
    "nuxt-security", // optional peer, detected by name via hasNuxtModule()
    "@convex-dev/polar", // optional peer detected by name; the website ships it for its Convex functions
    "@polar-sh/checkout", // optional peer the website provides for the module's import
    // Invoked as subprocesses by scripts/check-tarball.mjs (`pnpm exec publint`,
    // `pnpm exec attw`) rather than imported, so no static reference exists.
    // They moved there from .github/workflows/*.yml, which fallow does parse —
    // hence they only became "unused" when the gate stopped being duplicated.
    "publint",
    "@arethetypeswrong/cli",
    "portless", // invoked inside the nested-quoted `dev` script
    "typedoc-plugin-frontmatter", // both listed as plain strings in typedoc.json "plugin"
    "typedoc-plugin-markdown",
    "tailwindcss", // the website's CSS `@apply`s through Docus's Nuxt UI, which installs and runs it
    "@iconify-json/carbon", // the DevTools panel's icons; UnoCSS loads the set by name at build time
    // Docus installs Nuxt UI and the website imports it through Nuxt's `#ui`
    // alias. Listing it in website/package.json instead makes docus's own
    // OgImage component fail `nuxt typecheck`.
    "@nuxt/ui"
  ],

  // PR audits fail on every finding in the files a PR touches, not only the
  // ones fallow attributes to the PR. Under the default `new-only` gate, #51's
  // two clones read as inherited and passed, and main's full run then stayed
  // red for two weeks.
  "audit": { "gate": "all" },

  "duplicates": {
    // Reviewed clones, hidden until their content changes. chrome.css's
    // header rail restates depth.css's --inset-shadow-1/-2 layer for layer
    // with its own figures: a custom property's var()s resolve on the
    // element that declares it, so a scoped override has to restate the
    // whole value (the argument is in chrome.css beside the block). The
    // structure matches; the numbers are the point of the copy. The same goes
    // for its --gradient-recessed-ground restatement (dup:6c2c5d72).
    // dup:83a94bae: neon-icon and concave-icon each repaint the Iconify mask
    // as a ::before so a filter can draw on the glyph. Each effect stays a
    // self-contained utility; only the filter differs.
    // dup:90be2eeb and dup:75cc2c63: convex-helpers ships its own copy of
    // convex's paginated query, state updaters included, and the port keeps
    // both diffable against their sources (PARITY.md N-18).
    // dup:869f7a26 and dup:c6e88640: two type tests that each restate their
    // upstream's `expectTypeOf` scenarios.
    // dup:7654c248 and dup:8e91f9b1: Convex Auth's magic-link hook repeats the
    // run-once effect of its email-password `useLinkFlow` inline, and the port
    // keeps both files diffable against their sources (PARITY.md §2.1).
    "ignoredClones": ["dup:2fa4ad82:2", "dup:6c2c5d72:2", "dup:83a94bae:2", "dup:90be2eeb:2", "dup:75cc2c63:2", "dup:869f7a26:2", "dup:c6e88640:2", "dup:7654c248:2", "dup:8e91f9b1:2"]
  },

  "health": {
    // CRAP needs Istanbul input to mean anything. The CI gate runs without any,
    // the website and DevTools apps have no unit tests by design, and coverage
    // for src/ is already gated by vitest's thresholds — so here the score
    // degenerates to cyclomatic² and merely double-reports the complexity rules.
    "maxCrap": 0,
    "thresholdOverrides": [
      {
        "files": [
          "src/runtime/vue/composables/use-paginated-query.ts",
          "src/runtime/vue/queries-observer.ts"
        ],
        "maxCyclomatic": 25,
        "maxCognitive": 30,
        "reason": "Verbatim ports of convex/react (PARITY.md): the structure follows upstream so releases stay diffable file-for-file."
      },
      {
        "files": ["src/runtime/convex-auth/vue/methods/username-passkey/impl.ts"],
        "maxCognitive": 40,
        "reason": "A port of @convex-dev/auth's react_impl.tsx (PARITY.md): the autofill loop is one function upstream, and splitting it would hide its awaits and gate checks from a diff."
      },
      {
        "files": ["src/runtime/convex-helpers/vue/paginated.ts", "src/runtime/convex-helpers/vue/sessions.ts"],
        "maxCyclomatic": 30,
        "maxCognitive": 35,
        "reason": "Ports of convex-helpers' paginated query and ConvexReactSessionClient (PARITY.md): one function each upstream, kept whole so they diff against it."
      }
    ]
  }
}
